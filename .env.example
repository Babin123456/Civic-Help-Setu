# Everything prefixed VITE_ is copied into the public JavaScript bundle and can be
# read by anyone who opens the site. Only put public configuration here, never a
# server secret (sk_... keys, OpenAI/other AI keys, service account JSON, tokens).
# The build fails if a VITE_ variable looks like a secret. See docs/INTEGRATIONS.md.

# Clerk Authentication (publishable key only, never the sk_ secret key)
# Get your publishable key at https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key_here

# Server-only: used by /api/application-events to verify Clerk session tokens.
# Never prefix this with VITE_; VITE_ variables are included in the browser bundle.
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key_here

# Server-only: Internal Service Mesh Readiness Layer (#1276)
# MESH_AUTH_MODE=disabled|permissive|enforced (defaults to disabled for backward compatibility)
MESH_AUTH_MODE=disabled
MESH_TRANSPORT_MODE=auto
MESH_SERVICE_ID=civic-api-gateway
# MESH_KEYRING_JSON=[{"kid":"svc-a-2026-01","serviceId":"civic-worker","publicKeyPem":"...","status":"active"}]
# MESH_SIGNING_KEY_JSON={"kid":"gateway-2026-01","serviceId":"civic-api-gateway","privateKeyPem":"..."}
# MESH_TRUSTED_PROXY_SECRET=replace_with_mesh_proxy_attestation_secret
# MESH_TELEMETRY_SECRET=replace_with_hmac_telemetry_secret


