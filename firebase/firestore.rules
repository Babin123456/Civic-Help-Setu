rules_version = '2';

// Firestore security rules for CivicBridge. Deny by default.
// Access policy, field lists and the sign-in assumptions: docs/FIREBASE_RULES.md
// Tests: firebase/emulator (npm run rules:test) and scripts/firebaseRules.test.js
//
// Sign-in assumption: users sign in with Clerk and the app exchanges the Clerk session for a Firebase
// custom token. The token carries `role` ("admin" or "citizen") copied from Clerk publicMetadata
// by the token service, never from a Firestore document and never from the browser. Anonymous Firebase
// sessions may only file reports and feedback.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is asking ----------

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // A real (non-anonymous) account.
    function isMember() {
      return signedIn() && !isAnonymous();
    }

    function isOwner(uid) {
      return isMember() && request.auth.uid == uid;
    }

    // The role only ever comes from the signed token. `get` so a token without the claim is a citizen.
    function isAdmin() {
      return isMember() && request.auth.token.get('role', 'citizen') == 'admin';
    }

    // Tenant boundary helpers: tenantId comes only from the signed token, never from a document.
    function actorTenantId() {
      return request.auth.token.get('tenantId', '');
    }

    function hasValidTenantId(tenantId) {
      return tenantId is string
        && tenantId.matches('^(STATE|DISTRICT|MUNICIPALITY|DEPARTMENT|state|district|municipality|department):[A-Za-z0-9-]+$');
    }

    function canAccessTenant(targetTenantId) {
      return isMember()
        && hasValidTenantId(targetTenantId)
        && (
          request.auth.token.get('role', 'citizen') == 'super_admin'
          || (actorTenantId() != '' && actorTenantId() == targetTenantId)
        );
    }

    // ---------- what is being written ----------

    function incoming() {
      return request.resource.data;
    }

    function stored() {
      return resource.data;
    }

    function onlyKeys(allowed) {
      return incoming().keys().hasOnly(allowed);
    }

    function hasKeys(required) {
      return incoming().keys().hasAll(required);
    }

    function changedOnly(allowed) {
      return incoming().diff(stored()).affectedKeys().hasOnly(allowed);
    }

    function text(field, max) {
      return incoming()[field] is string && incoming()[field].size() > 0 && incoming()[field].size() <= max;
    }

    // Optional text field: absent, or a string within the limit.
    function maybeText(field, max) {
      return !(field in incoming()) || (incoming()[field] is string && incoming()[field].size() <= max);
    }

    function serverTime(field) {
      return incoming()[field] == request.time;
    }

    // Fields nobody may store, in any document, at any depth we can check: stops a client from
    // writing itself a role or a verified flag.
    function noPrivilegedKeys(map) {
      return !map.keys().hasAny(['role', 'roles', 'isAdmin', 'admin', 'superadmin', 'moderator', 'verified', 'permissions', 'uid', 'ownerId']);
    }

    // ---------- personal records: users/{uid}/... ----------
    // Everything a signed-in citizen keeps (the "Clear my data" categories in the app). Only that
    // person can read or change it. Admins have NO access: this is private citizen data.

    function ownedCollections() {
      return [
        'vaultDocs',        // document vault metadata (the file itself is in Storage: vault/{uid}/...)
        'saved',            // saved and compared guides
        'applications',     // tracked applications
        'officeTokens',     // office appointments
        'reminders',
        'settings',         // notification settings, language, fee preferences
        'assessments',      // eligibility checks
        'grievanceTickets',
        'checklists',
        'drafts',           // form drafts, journeys, visit plans, hand-offs
        'applicantProfiles',
        'scorecards',
        'assistantChats'
      ];
    }

    // The record envelope: one allowed set of top-level fields, and a `data` map of bounded size.
    function validRecord() {
      return onlyKeys(['data', 'schemaVersion', 'createdAt', 'updatedAt'])
        && hasKeys(['data', 'schemaVersion', 'updatedAt'])
        && incoming().data is map
        && incoming().data.size() <= 60
        && noPrivilegedKeys(incoming().data)
        && incoming().schemaVersion is int
        && incoming().schemaVersion >= 1
        && incoming().schemaVersion <= 100
        && serverTime('updatedAt')
        && (!('createdAt' in incoming()) || incoming().createdAt is timestamp);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && onlyKeys(['displayName', 'language', 'theme', 'createdAt', 'updatedAt'])
        && hasKeys(['createdAt'])
        && serverTime('createdAt')
        && maybeText('displayName', 100)
        && maybeText('language', 10)
        && maybeText('theme', 20);
      allow update: if isOwner(uid)
        && onlyKeys(['displayName', 'language', 'theme', 'createdAt', 'updatedAt'])
        && incoming().createdAt == stored().createdAt
        && maybeText('displayName', 100)
        && maybeText('language', 10)
        && maybeText('theme', 20);

      match /{collection}/{docId} {
        allow read, delete: if isOwner(uid) && collection in ownedCollections();
        allow create: if isOwner(uid) && collection in ownedCollections() && validRecord();
        allow update: if isOwner(uid) && collection in ownedCollections() && validRecord()
          && incoming().get('createdAt', null) == stored().get('createdAt', null);
      }

      // Privacy audit trail: the person can add entries and read them, never edit or delete one.
      match /privacyAudit/{entryId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && onlyKeys(['action', 'category', 'createdAt'])
          && hasKeys(['action', 'createdAt'])
          && text('action', 60)
          && maybeText('category', 60)
          && serverTime('createdAt');
        allow update, delete: if false;
      }
    }

    // ---------- public reference data ----------

    // Service guides: anyone can read, only admins change them.
    match /services/{serviceId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && incoming().keys().size() <= 60
        && text('name', 200)
        && text('category', 100)
        && maybeText('shortDescription', 2000);
      allow delete: if isAdmin();
    }

    // Gazette and public notices: only approved ones are public.
    match /notices/{noticeId} {
      allow read: if stored().status == 'approved' || isAdmin();
      allow create, update: if isAdmin()
        && incoming().keys().size() <= 30
        && text('title', 300)
        && incoming().status in ['pending_review', 'approved', 'rejected', 'archived'];
      allow delete: if isAdmin();
    }

    // Published aggregate numbers (no personal data), written only by the server.
    match /barrierInsights/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- citizen submissions ----------
    // Filing is open to any session, anonymous ones included, because reporting a broken link or a
    // barrier must not need an account. The filer can read their own report back; admins read and
    // moderate all of them; nobody else can read them (they may hold an e-mail address).

    function filedBy() {
      return signedIn() && incoming().reporterId == request.auth.uid;
    }

    match /errorReports/{reportId} {
      allow create: if filedBy()
        && onlyKeys(['reporterId', 'serviceId', 'serviceName', 'issueType', 'description', 'reporterEmail', 'status', 'createdAt'])
        && hasKeys(['reporterId', 'serviceId', 'issueType', 'description', 'status', 'createdAt'])
        && text('serviceId', 100)
        && maybeText('serviceName', 200)
        && text('issueType', 100)
        && text('description', 2000)
        && maybeText('reporterEmail', 200)
        && incoming().status == 'pending'
        && serverTime('createdAt');
      allow read: if isAdmin() || (signedIn() && stored().reporterId == request.auth.uid);
      allow update: if isAdmin()
        && changedOnly(['status', 'resolutionNotes', 'resolvedAt'])
        && incoming().status in ['pending', 'resolved']
        && maybeText('resolutionNotes', 1000);
      allow delete: if isAdmin();
    }

    match /serviceSubmissions/{submissionId} {
      allow create: if filedBy()
        && onlyKeys(['reporterId', 'name', 'category', 'shortDescription', 'processingTime', 'fees', 'officialUrl', 'contributorEmail', 'status', 'createdAt'])
        && hasKeys(['reporterId', 'name', 'category', 'status', 'createdAt'])
        && text('name', 200)
        && text('category', 100)
        && maybeText('shortDescription', 2000)
        && maybeText('processingTime', 100)
        && maybeText('fees', 100)
        && maybeText('officialUrl', 2000)
        && maybeText('contributorEmail', 200)
        && incoming().status == 'pending'
        && serverTime('createdAt');
      allow read: if isAdmin() || (signedIn() && stored().reporterId == request.auth.uid);
      allow update: if isAdmin()
        && changedOnly(['status', 'reviewNotes', 'reviewedAt'])
        && incoming().status in ['pending', 'approved', 'rejected']
        && maybeText('reviewNotes', 1000);
      allow delete: if isAdmin();
    }

    match /barrierReports/{reportId} {
      allow create: if filedBy()
        && onlyKeys(['reporterId', 'serviceId', 'barrierCategory', 'severity', 'description', 'trackingCodeHash', 'status', 'createdAt'])
        && hasKeys(['reporterId', 'serviceId', 'barrierCategory', 'status', 'createdAt'])
        && text('serviceId', 100)
        && text('barrierCategory', 60)
        && maybeText('severity', 20)
        && maybeText('description', 2000)
        && maybeText('trackingCodeHash', 128)
        && incoming().status == 'pending'
        && serverTime('createdAt');
      allow read: if isAdmin() || (signedIn() && stored().reporterId == request.auth.uid);
      allow update: if isAdmin()
        && changedOnly(['status', 'reviewerNotes', 'reviewedAt', 'reviewedBy'])
        && incoming().status in ['pending', 'approved', 'rejected'];
      allow delete: if isAdmin();
    }

    // Shared feedback is server-owned: public intake, quotas, quarantine, audit and
    // moderation authorization all pass through /api/bottleneck-feedback.
    match /bottleneckFeedback/{document=**} {
      allow read, write: if false;
    }
    match /bottleneckFeedbackAggregates/{document=**} {
      allow read, write: if false;
    }

    // Community discrepancy audits: readable by everyone (they are shown on the guide), filed by
    // signed-in accounts, resolved by admins. One vote per account, kept in a subcollection so a
    // client never edits a counter.
    match /communityAudits/{auditId} {
      allow read: if true;
      allow create: if isMember()
        && incoming().reporterId == request.auth.uid
        && onlyKeys(['reporterId', 'serviceId', 'category', 'title', 'description', 'status', 'createdAt'])
        && hasKeys(['reporterId', 'serviceId', 'category', 'title', 'status', 'createdAt'])
        && text('serviceId', 100)
        && text('category', 60)
        && text('title', 200)
        && maybeText('description', 2000)
        && incoming().status == 'PENDING_CORROBORATION'
        && serverTime('createdAt');
      allow update: if isAdmin()
        && changedOnly(['status', 'adminNote', 'resolvedBy', 'resolvedAt'])
        && incoming().status in ['PENDING_CORROBORATION', 'CORROBORATED', 'RESOLVED']
        && maybeText('adminNote', 1000);
      allow delete: if isAdmin();

      match /votes/{voterId} {
        allow read: if isOwner(voterId) || isAdmin();
        allow create, update: if isOwner(voterId)
          && onlyKeys(['vote', 'updatedAt'])
          && hasKeys(['vote', 'updatedAt'])
          && incoming().vote in ['UP', 'DOWN']
          && serverTime('updatedAt');
        allow delete: if isOwner(voterId);
      }
    }

    // ---------- admin only ----------

    // Roles come from the identity provider. Nothing in the app can change them through Firestore.
    match /roles/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if false;
    }

    // Append-only audit trail: admins add entries as themselves, and read them. No edits, no deletes.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && onlyKeys(['action', 'actorId', 'target', 'details', 'createdAt'])
        && hasKeys(['action', 'actorId', 'createdAt'])
        && incoming().actorId == request.auth.uid
        && text('action', 60)
        && maybeText('target', 300)
        && maybeText('details', 1000)
        && serverTime('createdAt');
      allow update, delete: if false;
    }

    // Secure export payloads and their metadata-only audit records are server-only.
    match /privacyExports/{exportId} {
      allow read, write: if false;
    }
    match /privacyExportAudit/{entryId} {
      allow read, write: if false;
    }

    // Durable event-sourced agent workflows: server-write-only via firebase-admin;
    // owners and admins may read materialized state and event logs.
    match /agentWorkflows/{workflowId} {
      allow read: if isAdmin() || (isMember() && resource.data.ownerId == request.auth.uid);
      allow write: if false;

      match /events/{sequenceId} {
        allow read: if isAdmin() || (isMember() && get(/databases/$(database)/documents/agentWorkflows/$(workflowId)).data.ownerId == request.auth.uid);
        allow write: if false;
      }

      match /idempotency/{keyId} {
        allow read, write: if false;
      }
    }

    match /agentWorkflowDeadLetters/{dlqId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /sourceConflicts/{conflictId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && incoming().keys().size() <= 40;
    }

    match /reviewOverrides/{serviceId} {
      allow read, write: if isAdmin();
    }


    // Human-in-the-Loop Agent Review Studio (#1150): admin-only, approved snapshots immutable.
    match /agentReviewOutputs/{outputId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && noPrivilegedKeys(incoming())
        && text('status', 40)
        && text('contractVersion', 40)
        && incoming().version is int
        && incoming().version >= 1;
      allow update: if isAdmin()
        && noPrivilegedKeys(incoming())
        && !(stored().status in ['approved', 'edited_approved'])
        && incoming().version == stored().version + 1;
      allow delete: if false;
    }


    // ---------- shelter status board ----------

    // Shelter sites: readable by all, writable by verified operators within their jurisdiction
    match /shelter_sites/{shelterSiteId} {
      allow read: if true;
      allow create, update: if isMember()
        && onlyKeys(['data', 'schemaVersion', 'createdAt', 'updatedAt'])
        && hasKeys(['data', 'schemaVersion', 'updatedAt'])
        && incoming().schemaVersion is int
        && incoming().schemaVersion >= 1
        && incoming().schemaVersion <= 100
        && serverTime('updatedAt')
        && (!('createdAt' in incoming()) || incoming().createdAt is timestamp)
        && noPrivilegedKeys(incoming().data)
        && text('name', 200)
        && text('jurisdiction', 100)
        && maybeText('address', 500)
        && maybeText('contact', 100)
        && maybeText('altContact', 50)
        && maybeText('email', 200)
        && maybeText('website', 200)
        && maybeEnum('status', ['OPEN', 'CLOSED', 'TEMPORARILY_CLOSED', 'MAINTENANCE'])
        && maybeEnum('accessibility.wheelchairAccessible', [true, false])
        && maybeEnum('accessibility.hearingImpaired', [true, false])
        && maybeEnum('accessibility.visuallyImpaired', [true, false])
        && maybeNumber('capacityTotal', 1, 10000)
        && maybeNumber('capacityAvailable', 0, 10000)
        && maybeNumber('occupancyRate', 0, 100)
        && locationValid()
        && maybeText('contactType', 50);
    }

    // Capacity snapshots: append-only history, readable by all, writable by operators/admins
    match /capacity_snapshots/{snapshotId} {
      allow read: if true;
      allow create: if isMember()
        && onlyKeys(['data', 'schemaVersion', 'createdAt', 'updatedAt'])
        && hasKeys(['data', 'schemaVersion', 'updatedAt'])
        && incoming().schemaVersion is int
        && incoming().schemaVersion >= 1
        && incoming().schemaVersion <= 100
        && serverTime('updatedAt')
        && (!('createdAt' in incoming()) || incoming().createdAt is timestamp)
        && noPrivilegedKeys(incoming().data)
        && hasKeys(['shelterSiteId', 'capacityAvailable', 'capacityTotal', 'occupancyRate', 'updateSource'])
        && text('shelterSiteId', 100)
        && number('capacityAvailable') >= 0
        && number('capacityAvailable') <= number('capacityTotal')
        && number('capacityTotal') >= 1
        && number('capacityTotal') <= 10000
        && number('occupancyRate') >= 0
        && number('occupancyRate') <= 100
        && text('updateSource', 100)
        && maybeText('notes', 500);
      allow update, delete: if false;
    }

    // Facility services: water, power, sanitation, medical, food at shelter sites
    match /facility_services/{serviceId} {
      allow read: if true;
      allow create, update: if isMember()
        && onlyKeys(['data', 'schemaVersion', 'createdAt', 'updatedAt'])
        && hasKeys(['data', 'schemaVersion', 'updatedAt'])
        && incoming().schemaVersion is int
        && incoming().schemaVersion >= 1
        && incoming().schemaVersion <= 100
        && serverTime('updatedAt')
        && (!('createdAt' in incoming()) || incoming().createdAt is timestamp)
        && noPrivilegedKeys(incoming().data)
        && text('shelterSiteId', 100)
        && enum('serviceType', ['WATER', 'POWER', 'SANITATION', 'MEDICAL', 'FOOD'])
        && enum('status', ['AVAILABLE', 'LIMITED', 'UNAVAILABLE'])
        && maybeNumber('capacityTotal', 1, 10000)
        && maybeNumber('capacityAvailable', 0, 10000)
        && maybeNumber('lastVerified', 0, 2147483647)
        && maybeText('notes', 500);
    }

    // Operator accounts: managed by admins, read by authorized roles
    match /operator_accounts/{operatorId} {
      allow read: if isAdmin() || (isMember() && stored().operatorId == request.auth.uid);
      allow create: if isAdmin()
        && onlyKeys(['data', 'schemaVersion', 'createdAt', 'updatedAt'])
        && hasKeys(['data', 'schemaVersion', 'updatedAt'])
        && incoming().schemaVersion is int
        && incoming().schemaVersion >= 1
        && incoming().schemaVersion <= 100
        && serverTime('updatedAt')
        && (!('createdAt' in incoming()) || incoming().createdAt is timestamp)
        && noPrivilegedKeys(incoming().data)
        && text('name', 200)
        && maybeText('email', 200)
        && maybeText('phone', 50)
        && maybeEnum('role', ['OPERATOR', 'ADMIN'])
        && maybeText('jurisdiction', 100)
        && maybeText('verificationStatus', 50)
        && maybeText('onboardingId', 100);
      allow update: if isAdmin()
        && changedOnly(['data', 'updatedAt'])
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Status events: append-only audit trail of state changes
    match /status_events/{eventId} {
      allow read: if isAdmin() || (isMember() && stored().operatorId == request.auth.uid);
      allow create: if isMember()
        && onlyKeys(['data', 'schemaVersion', 'createdAt', 'updatedAt'])
        && hasKeys(['data', 'schemaVersion', 'createdAt', 'updatedAt'])
        && incoming().schemaVersion is int
        && incoming().schemaVersion >= 1
        && incoming().schemaVersion <= 100
        && serverTime('updatedAt')
        && (!('createdAt' in incoming()) || incoming().createdAt is timestamp)
        && noPrivilegedKeys(incoming().data)
        && hasKeys(['shelterSiteId', 'eventType', 'oldState', 'newState', 'operatorId', 'timestamp', 'description'])
        && text('shelterSiteId', 100)
        && enum('eventType', ['CAPACITY_UPDATE', 'SERVICE_UPDATE', 'CLOSURE', 'REOPENING', 'VERIFICATION'])
        && enum('oldState', ['OPEN', 'CLOSED', 'TEMPORARILY_CLOSED', 'MAINTENANCE'])
        && enum('newState', ['OPEN', 'CLOSED', 'TEMPORARILY_CLOSED', 'MAINTENANCE'])
        && maybeText('operatorId', 100)
        && text('description', 500)
        && maybeText('details', 1000);
      allow update, delete: if false;
    }

    // Verification checks: validation records for shelter data
    match /verification_checks/{checkId} {
      allow read: if isAdmin() || (isMember() && stored().checkedBy == request.auth.uid);
      allow create: if isMember()
        && onlyKeys(['data', 'schemaVersion', 'createdAt', 'updatedAt'])
        && hasKeys(['data', 'schemaVersion', 'createdAt', 'updatedAt'])
        && incoming().schemaVersion is int
        && incoming().schemaVersion >= 1
        && incoming().schemaVersion <= 100
        && serverTime('updatedAt')
        && (!('createdAt' in incoming()) || incoming().createdAt is timestamp)
        && noPrivilegedKeys(incoming().data)
        && hasKeys(['shelterSiteId', 'checkType', 'checkedBy', 'status', 'timestamp'])
        && text('shelterSiteId', 100)
        && enum('checkType', ['CAPACITY', 'SERVICES', 'ACCESSIBILITY'])
        && enum('status', ['PENDING', 'PASSED', 'FAILED'])
        && maybeText('checkedBy', 100)
        && text('notes', 500)
      && maybeEnum('rating', [1, 2, 3, 4, 5])
        && maybeText('reviewerId', 100);
      allow update, delete: if false;
    }

    function locationValid() {
      return maybeText('lat', 30) && maybeText('lng', 30);
    }

    // ---------- civic service change feed collections ----------

    // Immutable service version records
    match /service_versions/{versionId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Versioned civic service change events
    match /change_events/{eventId} {
      allow read: if isAdmin() || (stored().status == 'approved');
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // User subscriptions to service change alerts
    match /user_subscriptions/{subId} {
      allow read: if isAdmin() || (isMember() && stored().userId == request.auth.uid);
      allow create: if isMember() && incoming().userId == request.auth.uid;
      allow update, delete: if isMember() && stored().userId == request.auth.uid;
    }

    // Delivery attempts (idempotent notification records)
    match /delivery_attempts/{attemptId} {
      allow read: if isAdmin() || (isMember() && stored().recipientId == request.auth.uid);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Review approvals (human-in-the-loop review audit records)
    match /review_approvals/{approvalId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- civic micro-volunteer task board (#759) ----------

    // Reference categories for low-risk micro-tasks: public read, admin-only write
    match /task_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Micro-volunteer tasks: public read, staff create/update, no hard deletion (archive only)
    match /micro_tasks/{taskId} {
      allow read: if true;
      allow create: if isMember()
        && text('title', 120)
        && text('instructions', 2000)
        && text('categoryId', 60)
        && text('jurisdictionId', 60)
        && incoming().status in ['draft', 'open', 'assigned', 'awaiting_review', 'completed', 'reopened', 'archived'];
      allow update: if isMember()
        && incoming().status in ['draft', 'open', 'assigned', 'awaiting_review', 'completed', 'reopened', 'archived'];
      allow delete: if false;
    }

    // Task claims: citizen can claim and view own, reviewers/admins can view and manage
    match /task_claims/{claimId} {
      allow read: if isAdmin() || (isMember() && (stored().citizenId == request.auth.uid || stored().userId == request.auth.uid));
      allow create: if isMember()
        && hasKeys(['taskId', 'citizenId', 'status', 'createdAt'])
        && (incoming().citizenId == request.auth.uid || isAdmin())
        && incoming().status in ['active', 'submitted', 'approved', 'changes_requested', 'rejected', 'withdrawn', 'expired'];
      allow update: if isMember()
        && (stored().citizenId == request.auth.uid || isAdmin())
        && incoming().status in ['active', 'submitted', 'approved', 'changes_requested', 'rejected', 'withdrawn', 'expired'];
      allow delete: if false;
    }

    // Completion submissions: evidence notes, link, file metadata only (no blobs or PII)
    match /completion_submissions/{submissionId} {
      allow read: if isAdmin() || (isMember() && (stored().citizenId == request.auth.uid || stored().userId == request.auth.uid));
      allow create: if isMember()
        && hasKeys(['taskId', 'claimId', 'citizenId', 'status', 'createdAt'])
        && (incoming().citizenId == request.auth.uid || isAdmin())
        && incoming().status in ['submitted', 'under_review', 'approved', 'changes_requested', 'rejected', 'reopened', 'withdrawn'];
      allow update: if isAdmin() || (isMember() && stored().citizenId == request.auth.uid);
      allow delete: if false;
    }

    // Moderation events: append-only audit trail
    match /moderation_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isMember()
        && hasKeys(['taskId', 'action', 'actorRole', 'createdAt'])
        && text('action', 60);
      allow update, delete: if false;
    }

    // Server API only: verified Clerk moderators use Admin SDK transactions.
    match /publicToiletSubmissions/{submissionId} {
      allow read, write: if false;
    }

    // Governed Agent Tool Registry (#1146): server-only audit & revocation records.
    match /agent_tool_registry_revocations/{revocationId} {
      allow read, write: if false;
    }
    match /agent_tool_registry_audit/{auditId} {
      allow read, write: if false;
    }


    // ---------- everything else ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
