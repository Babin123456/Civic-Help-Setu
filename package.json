{
  "name": "civic-help-setu",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "scorecard": "node scripts/platform-scorecard/collect.mjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:security": "eslint -c eslint.security.config.js --max-warnings 0 src",
    "headers:generate": "node scripts/generateVercelHeaders.js",
    "headers:check": "node scripts/generateVercelHeaders.js --check",
    "preview": "vite preview",
    "test": "vitest run",
    "test:reconciliation": "vitest run tests/reconciliation-synthetic-bench.test.js",
    "rules:test": "npm --prefix firebase/emulator install --no-audit --no-fund && npm --prefix firebase/emulator test",
    "eval:contracts": "node scripts/evaluateAgentContracts.mjs",
    "eval:harness": "node scripts/runCivicAgentEvalHarness.mjs",
    "eval:gateway": "vitest run src/services/gateway/gatewayEvaluationReport.test.js",
    "lhci:collect": "lhci collect",
    "lhci:assert": "lhci assert",
    "contracts:check": "node scripts/contracts/check.mjs",
    "contracts:validate": "node scripts/contracts/validate.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.31.4",
    "@clerk/clerk-react": "^5.61.10",
    "@clerk/react": "^6.19.4",
    "@clerk/themes": "^2.4.57",
    "firebase-admin": "^14.5.1",
    "lucide-react": "^1.77.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "lighthouse": "^13.6.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}